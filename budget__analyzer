        "# Fresher Budget Analyzer - Google Colab Version\n",
        "# Pandas + Numpy - No Input Needed\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Sample Data - Hyderabad Fresher Expenses\n",
        "data = {\n",
        "    \"Date\": [\"04-11-2026\", \"04-11-2026\", \"04-11-2026\", \"04-11-2026\", \"04-11-2026\"],\n",
        "    \"Category\": [\"PG\", \"Food\", \"Bus\", \"Recharge\", \"Food\"],\n",
        "    \"Amount\": [6000, 2500, 1000, 300, 1200]\n",
        "}\n",
        "\n",
        "# Creating DataFrame with Pandas\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(\"====== BUDGET REPORT ======\")\n",
        "print(df)\n",
        "\n",
        "# Calculations with Numpy\n",
        "total = np.sum(df[\"Amount\"])\n",
        "average = np.mean(df[\"Amount\"])\n",
        "highest = np.max(df[\"Amount\"])\n",
        "lowest = np.min(df[\"Amount\"])\n",
        "\n",
        "print(f\"\\nTotal Expense: Rs.{total}\")\n",
        "print(f\"Average Expense: Rs.{average:.2f}\")\n",
        "print(f\"Highest Expense: Rs.{highest}\")\n",
        "print(f\"Lowest Expense: Rs.{lowest}\")\n",
        "\n",
        "# Category Wise Total with Pandas groupby - This is what Recruiter will ask\n",
        "print(\"\\n--- Category Wise Total ---\")\n",
        "category_wise = df.groupby(\"Category\")[\"Amount\"].sum()\n",
        "print(category_wise)\n",
        "\n",
        "# Smart Advice\n",
        "top_category = df.groupby(\"Category\")[\"Amount\"].sum().idxmax()\n",
        "print(f\"\\nSmart Advice: You are spending most on '{top_category}'.\")\n",
        "print(f\"If you reduce '{top_category}' by 20% next month, you can save Rs.{total * 0.20:.0f}.\")\n",
        "\n",
        "# Salary Comparison\n",
        "salary = 20000\n",
        "remaining = salary - total\n",
        "print(f\"\\nSalary: Rs.{salary}\")\n",
        "print(f\"Remaining Money: Rs.{remaining}\")\n",
        "print(\"Super! You are saving well.\" if remaining > 5000 else \"Careful! Your savings are low.\")"
      ]
